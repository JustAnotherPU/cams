[Unit]
Description=jap-ridewatch: UniFi Protect camera stream service (ctl socket for the RideWatch app; feeds the camdec decoder)
RequiresMountsFor=/var/opt
After=local-fs.target

[Service]
# nobody: mgu-render accepts frame files from the app uid, root or nobody (PROTOCOL.md "Video");
# video = renderD128 for the MSDK; group tm_oap_app makes ctl.sock 0660 reachable by the app.
User=nobody
Group=tm_oap_app
SupplementaryGroups=video
# '+' runs as root: the deploy tool installs everything 0:0; nobody needs its own state dir and must own the
# server.json put there (token: 0600)
ExecStartPre=-+/bin/sh -c 'mkdir -p /var/opt/jap-ridewatch/state && chown nobody:tm_oap_app /var/opt/jap-ridewatch/state && chmod 0700 /var/opt/jap-ridewatch/state && if [ -f /var/opt/jap-ridewatch/state/server.json ]; then chown nobody /var/opt/jap-ridewatch/state/server.json && chmod 0600 /var/opt/jap-ridewatch/state/server.json; fi'
# a frame file left by another owner (root, a test) makes camdec exit 2 as nobody (/dev/shm is sticky)
ExecStartPre=-+/bin/sh -c '[ -e /dev/shm/jap-video-ridewatch ] && [ "$(stat -c %%U /dev/shm/jap-video-ridewatch)" != nobody ] && rm -f /dev/shm/jap-video-ridewatch; true'
Environment=JAP_RIDEWATCH_CONF=/var/opt/jap-ridewatch/state/server.json
Environment=JAP_RIDEWATCH_CTL=/run/jap-ridewatch/ctl.sock
Environment=JAP_CAMDEC=/var/opt/jap-ridewatch/current/camdec
Environment=JAP_RIDEWATCH_VIDEO=/dev/shm/jap-video-ridewatch
ExecStart=/var/opt/jap-node22/current/bin/node /var/opt/jap-ridewatch/current/ridewatchd.js
RuntimeDirectory=jap-ridewatch
# 0755 like Moonride's: the socket itself is 0660, so only the app's group gets in
RuntimeDirectoryMode=0755
# the daemon (~40 MB) + camdec (MSDK surfaces for one 1920x720 stream) + at most 4 MB held before an IDR;
# CPU: the decode is the GPU's, the NV12->I420 copy and the pipe are ours (to measure on the car)
MemoryLimit=256M
CPUQuota=150%
# Starts idle and stays active with no server.json, no network and no app, so the deploy health check sees it active.
Restart=on-failure
# 3 s keeps clear of systemd's 5-starts-in-10-s limit.
RestartSec=3
# SIGTERM: stream closed, camdec's stdin ended (killed after 1 s), exit (1.2 s cap in ridewatchd.js).
TimeoutStopSec=5
# 1, not 0: with a pipe core_pattern the kernel still pipes a core at limit 0 (as in RideTube).
LimitCORE=1

[Install]
WantedBy=multi-user.target
